@inherits LayoutComponentBase

<header class="site-head">
    <div class="wrap">
        <p class="eyebrow">Atc.Rest.Client · showcase</p>
        <h1>Streamed responses, read as they arrive</h1>
        <p class="lede">
            This page runs Atc.Rest.Client in your browser. Every price below is one item of a single HTTP
            response that has not ended yet.
        </p>
    </div>
</header>

<main class="wrap">
    @Body
</main>

<footer class="wrap site-foot">
    <p>
        Source: <code>sample/Showcase</code> ·
        the HTTP code of this page is one file, <code>Services/PriceStreamClient.cs</code>.
    </p>
</footer>